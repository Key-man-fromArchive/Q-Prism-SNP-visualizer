# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Node
node_modules/

# Test artifacts
test-results/
playwright-report/

# Logs
logs/

# Raw data (large binary files)
RAW-data/
Quantstudio3/

# CFX analysis data (keep .md specs, exclude raw exports)
CFX-opus/*.xml
CFX-opus/*.xlsx

# Claude Code session data
# Local agent state (orchestrate-state.json and friends) stays out, but the
# project's own commands are part of the repo: they encode how THIS project is
# operated, and a skill nobody else has is a skill that goes stale.
.claude/*
!.claude/commands/

# Database (runtime)
snp-analyzer/app/data/

# React build output (regenerated by npm run build)
snp-analyzer/app/static-react/

# Environment secrets
.env
snp-analyzer/.env
snp-analyzer/pcrd-pw.txt
snp-analyzer/app.env

# Docker volumes / runtime
*.egg-info/

# Temporary scripts
*.mjs

# Screenshots pulled out of the feedback store for triage — user content, never committed.
feedback-shots/
