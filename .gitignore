# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Node
node_modules/
# Without the slash too: a SYMLINK named node_modules is not matched by the
# directory pattern, which is how one got committed (99fbe25) and later
# replaced a real install on checkout.
node_modules

# Test artifacts
test-results/
playwright-report/

# Logs
logs/

# Raw data (large binary files)
RAW-data/
Quantstudio3/

# CFX analysis data (keep .md specs, exclude raw exports)
CFX-opus/*.xml
CFX-opus/*.xlsx

# Claude Code session data
.claude/

# Database (runtime)
snp-analyzer/app/data/

# React build output (regenerated by npm run build)
snp-analyzer/app/static-react/

# Environment secrets
.env
snp-analyzer/.env
snp-analyzer/pcrd-pw.txt
snp-analyzer/app.env

# Docker volumes / runtime
*.egg-info/

# Temporary scripts
*.mjs
